{
  "name": "@maveio/components",
  "version": "0.0.195",
  "description": "privacy friendly (🇪🇺), iframe-less, video UI elements for videos hosted on mave.io",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "ts-types": "node scripts/build-types.mjs",
    "build": "tsup",
    "build:watch": "NODE_ENV=development tsup --watch --sourcemap --no-clean",
    "build:prod": "NODE_ENV=production tsup",
    "build:cdn": "node scripts/build-cdn.mjs",
    "localize": "lit-localize extract && ./node_modules/.bin/lit-localize build",
    "prepublishOnly": "npm run build:prod",
    "lint:fix": "eslint src --fix",
    "lint:format": "prettier --log-level warn --write \"./**/*.{ts,tsx,css,md,json}\"",
    "lint": "eslint src",
    "serve": "vite --host localhost --port 5173 --strictPort --open /examples/index.html",
    "start": "npm run build && concurrently \"npm run build:watch\" \"npm run serve\"",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:package": "npm run build:prod && vitest run --config vitest.package.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maveio/components.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@lit/localize-tools": "^0.8.2",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "acorn": "8.18.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-replace": "^2.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  },
  "author": "mave.io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maveio/components/issues"
  },
  "homepage": "https://github.com/maveio/components#readme",
  "dependencies": {
    "@lit-labs/observers": "^2.1.0",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@lit/localize": "^0.12.2",
    "@lit/react": "^1.0.8",
    "@lit/task": "^1.0.3",
    "@maveio/data": "^0.1.2",
    "hls.js": "^1.7.3",
    "lit": "^3.3.3",
    "media-chrome": "^4.19.3",
    "phoenix": "^1.8.15",
    "tus-js-client": "^4.3.1"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "shell-quote": "^1.8.4"
  }
}
